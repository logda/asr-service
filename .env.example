# ===== Service =====
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ===== Auth =====
# Replace with a strong secret in production
ASR_API_KEY=sk-your-key

# ===== Database =====
DATABASE_URI=sqlite+aiosqlite:///./asr_service.db

# ===== Worker =====
MAX_CONCURRENT_TASKS=1
MAX_RETRIES=2
POLL_INTERVAL_SEC=2
DOWNLOAD_TIMEOUT_SEC=30

# ===== FunASR =====
FUNASR_DEVICE=cpu
# 热词依赖 SeACo-Paraformer；需要无热词基线时改回 paraformer-zh
FUNASR_MODEL=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
FUNASR_MODEL_REVISION=v2.0.4
FUNASR_VAD_MODEL_REVISION=v2.0.4
FUNASR_PUNC_MODEL_REVISION=v2.0.4
FUNASR_SPK_MODEL_REVISION=v2.0.2
MODELS_DIR=./models

# ===== Hotword =====
HOTWORD_ENABLED=true
# 请求未携带热词时的全局兜底词表，空格/逗号分隔
DEFAULT_HOTWORDS=
MAX_HOTWORD_WORDS=100
MAX_HOTWORD_CHARS=2000

# ===== Upload =====
UPLOAD_DIR=./uploads/asr
