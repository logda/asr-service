# ===== Service =====
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ===== Auth =====
# Replace with a strong secret in production
ASR_API_KEY=sk-your-key

# ===== Database =====
DATABASE_URI=sqlite+aiosqlite:///./asr_service.db

# ===== Worker =====
MAX_CONCURRENT_TASKS=1
MAX_RETRIES=2
POLL_INTERVAL_SEC=2
DOWNLOAD_TIMEOUT_SEC=30

# ===== FunASR =====
FUNASR_DEVICE=cpu
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
FUNASR_MODEL_REVISION=v2.0.4
FUNASR_VAD_MODEL_REVISION=v2.0.4
FUNASR_PUNC_MODEL_REVISION=v2.0.4
FUNASR_SPK_MODEL_REVISION=v2.0.2
MODELS_DIR=./models

# ===== Upload =====
UPLOAD_DIR=./uploads/asr
