FROM docker.m.daocloud.io/library/python:3.10-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# uv 走阿里 PyPI 镜像安装
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple uv==0.8.2

# torch CPU 版（+cpu 本地版本号只存在于 pytorch-wheels 仓库，不走 uv.lock）
RUN uv venv /app/.venv --python /usr/local/bin/python3 \
 && uv pip install --python /app/.venv/bin/python \
      --index https://mirrors.aliyun.com/pypi/simple/ \
      --find-links https://mirrors.aliyun.com/pytorch-wheels/cpu/ \
      torch==2.6.0+cpu torchaudio==2.6.0+cpu \
 && uv pip install --python /app/.venv/bin/python \
      --index https://mirrors.aliyun.com/pypi/simple/ \
      -r requirements.txt

COPY app/ ./app/
RUN mkdir -p /app/models /app/uploads/asr
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8001/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
