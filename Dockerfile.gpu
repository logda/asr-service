FROM docker.m.daocloud.io/library/python:3.10-slim-bullseye

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 \
    UV_CONCURRENT_DOWNLOADS=8 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN printf 'deb http://mirrors.aliyun.com/debian-archive/debian bullseye main\n' > /etc/apt/sources.list \
 && apt-get update -o Acquire::Check-Valid-Until=false \
 && apt-get install -y --no-install-recommends \
        ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# uv 走阿里 PyPI 镜像安装；依赖清单与锁文件由宿主机 `make lock` 维护
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple uv==0.8.2

# 严格按 uv.lock 安装（--frozen），不装 dev 依赖组；缓存挂载避免重复下载
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --python /usr/local/bin/python3

COPY app/ ./app/
RUN mkdir -p /app/models /app/uploads/asr
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8001/health || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
